<button id="noBtn" onmouseover="moveNo()">No</button>
</div>

<!-- SECTION 5 -->
<div class="section" id="s5">
<h1>She Said YESSSSS ❤️🎉</h1>
<img src="https://media.tenor.com/5UuKJ0pXgKQAAAAi/love-hearts.gif">
<h2>I Love You Forever Pratibha 💖</h2>
</div>

<script>

function next(num){
document.querySelectorAll(".section").forEach(s=>s.classList.remove("active"));
document.getElementById("s"+num).classList.add("active");
}

function moveNo(){
let btn=document.getElementById("noBtn");
btn.style.position="absolute";
btn.style.top=Math.random()*80+"%";
btn.style.left=Math.random()*80+"%";
}

function celebrate(){
next(5);
createHearts(80);
}

function createHearts(count){
for(let i=0;i<count;i++){
let heart=document.createElement("div");
heart.className="heart";
heart.innerHTML=["❤️","💖","💕","💘","😍"][Math.floor(Math.random()*5)];
heart.style.left=Math.random()*100+"%";
heart.style.animationDuration=(Math.random()*3+2)+"s";
document.body.appendChild(heart);
}
}

function startNicknames(){
createHearts(40);

let names=[
"Chotu 🤭",
"Pyalu mummalaaa 😁",
"Mumma ji 🤗",
"Aloo pakoli 😋",
"Pratuuu beta 🥰",
"Mera bacha 😘😘",
"Shehzadi 🥰",
"Meri choti bachi 🥰",
"Jivda 🥰"
];

let i=0;
let interval=setInterval(()=>{
if(i>=names.length){
clearInterval(interval);
document.getElementById("nextBtn").style.display="inline-block";
return;
}
let nick=document.createElement("div");
nick.className="nickname";
nick.innerHTML=names[i];
nick.style.top=Math.random()*70+"%";
nick.style.left=Math.random()*70+"%";
document.body.appendChild(nick);
i++;
},3000);
}

</script>

</body>
</html>