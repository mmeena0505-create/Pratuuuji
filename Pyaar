<!-- SECTION 3 -->
<div class="section" id="s3">
<h1>💕 Love & Nickname Rain 💕</h1>
<button onclick="startNicknames()">Start</button>
<br><br>
<button id="nextBtn" style="display:none;" onclick="next(4)">Next</button>
